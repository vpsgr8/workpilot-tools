# BizBuilt API — copy to .env and fill in values
PORT=8080
NODE_ENV=development

# PostgreSQL (Cloud SQL or local)
DATABASE_URL=postgresql://bizbuilt:password@localhost:5432/bizbuilt

# JWT session secret (generate a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Restrict login to this email domain (e.g. acmecorp.com). Leave empty to allow any Google account.
ALLOWED_DOMAIN=

# Company / tenant for this deployment
COMPANY_NAME=Demo SME Pvt Ltd
LICENSE_TIER=starter
MAX_EMPLOYEES=10
LICENSE_EXPIRES=2027-12-31

# Frontend origin(s) for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5500,https://workpilottools.biz,https://englishlearner.store,https://logictrade.site

# Signed download tokens for paid eBooks (defaults to JWT_SECRET if set)
EBOOK_DOWNLOAD_SECRET=

# Razorpay — copy key_id + key_secret from rzp-key.csv into server/.env (never commit .env)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_MERCHANT_NAME=WorkPilot Tools
RAZORPAY_MERCHANT_DESC=MarketMind Labs
